{
  extends: ['config:best-practices'],
  dependencyDashboard: true,
  argocd: {
    managerFilePatterns: [
      'gitops/**/*/install.yaml',
      'gitops/**/*/resources.yaml',
      'gitops/**/*/kustomization.yaml',
    ],
  },
  "pre-commit": {
    enabled: true,
  },
  // Track `image:` tags in the ArgoCD repo-server overlays (argocd, alpine/helm,
  // ksops). Scoped narrowly so chart-value `image:` keys elsewhere stay untouched.
  kubernetes: {
    managerFilePatterns: ['/^gitops/base-install/argocd/overlays/.*\\.yaml$/'],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Update versions embedded in download URLs',
      managerFilePatterns: ['/^(.*).yaml$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?)\\s+packageName=(?<packageName>.+?)\\s+.*(?:https?://.+?/)(?<currentValue>v[\\d.]+)',
      ],
    },
    {
      customType: 'regex',
      description: 'Update bare tool versions held in container env vars',
      managerFilePatterns: ['/^(.*).yaml$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?)\\s+packageName=(?<packageName>\\S+)\\s+- name:\\s*\\S+\\s+value:\\s*"(?<currentValue>[^"]+)"',
      ],
      // Values are stored without the leading `v` that the upstream tags carry.
      extractVersionTemplate: '^v?(?<version>.+)$',
    },
    {
      customType: 'regex',
      description: 'Update container images named in chart values files (imageName: repo:tag)',
      managerFilePatterns: ['/^gitops/components/.*/values\\.yaml$/'],
      matchStrings: ['imageName:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)'],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Update sidecar images pinned by tag and digest inside Application valuesObject blocks',
      managerFilePatterns: ['/^gitops/components/.*/kustomization\\.yaml$/'],
      matchStrings: ['image:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})'],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      description: 'ArgoCD version lives in two install URLs and one init-container image — bump them together',
      matchPackageNames: ['argoproj/argo-cd', 'quay.io/argoproj/argocd'],
      groupName: 'argo-cd',
    },
    {
      description: 'karpenter chart and crds',
      matchPackageNames: [
        'public.ecr.aws/karpenter/karpenter',
        'public.ecr.aws/karpenter/karpenter-crd',
      ],
      groupName: 'karpenter',
    },
    {
      description: 'azure karpenter chart and crds',
      matchPackageNames: [
        'mcr.microsoft.com/aks/karpenter/karpenter',
        'mcr.microsoft.com/aks/karpenter/karpenter-crd',
      ],
      groupName: 'karpenter-azure',
    },
    {
      description: 'One PR for everything under the harbor component: chart, Postgres image, sidecar',
      matchFileNames: ['gitops/components/harbor/**', 'gitops/components/aws/harbor-s3/**'],
      groupName: 'harbor',
    },
  ],
}
